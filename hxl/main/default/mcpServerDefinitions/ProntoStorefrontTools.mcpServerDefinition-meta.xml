    <idempotent>true</idempotent>
    <openWorld>false</openWorld>
    <readOnly>true</readOnly>
    <returnDirect>false</returnDirect>
    <toolName>getStorefrontFromName</toolName>
    <toolTitle>Get Storefront From Name</toolTitle>
  </tools>
  <tools>
    <apiDefinition>
      <apiIdentifier>aa:apex-GetStorefrontMenuAction</apiIdentifier>
      <apiSource>API_CATALOG</apiSource>
      <operation>GetStorefrontMenuAction</operation>
    </apiDefinition>
    <uiResource>getStorefrontMenu</uiResource>
    <descriptionOverride>Show the menu for a Pronto storefront by name: available dishes, descriptions, and prices. Read-only; run it without asking for confirmation.</descriptionOverride>
    <destructive>false</destructive>
    <idempotent>true</idempotent>
    <openWorld>false</openWorld>
    <readOnly>true</readOnly>
    <returnDirect>false</returnDirect>
    <toolName>getStorefrontMenu</toolName>
    <toolTitle>Get Storefront Menu</toolTitle>
