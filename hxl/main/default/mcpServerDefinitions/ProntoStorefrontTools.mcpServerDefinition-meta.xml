<?xml version="1.0" encoding="UTF-8"?>
<McpServerDefinition xmlns="http://soap.sforce.com/2006/04/metadata">
  <description>Pronto storefront tools that render HXL widgets.</description>
  <masterLabel>Pronto Storefront Tools</masterLabel>
  <tools>
    <apiDefinition>
      <apiIdentifier>aa:apex-GetStorefrontFromNameAction</apiIdentifier>
      <apiSource>API_CATALOG</apiSource>
      <operation>GetStorefrontFromNameAction</operation>
    </apiDefinition>
    <uiResource>getStorefrontFromName</uiResource>
