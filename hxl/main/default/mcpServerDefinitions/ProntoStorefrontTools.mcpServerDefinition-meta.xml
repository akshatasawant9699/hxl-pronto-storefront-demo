    <resourceUri>ui://widget/lightningType/c__getStorefrontFromName</resourceUri>
  </resources>
  <resources>
    <description>Represents a storefront menu.</description>
    <resourceName>getStorefrontMenu</resourceName>
    <resourceTitle>Storefront Menu</resourceTitle>
    <resourceUri>ui://widget/lightningType/c__getStorefrontMenu</resourceUri>
  </resources>
</McpServerDefinition>
