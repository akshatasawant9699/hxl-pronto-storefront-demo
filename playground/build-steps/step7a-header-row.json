{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/column",
          "attributes": {
            "gap": "md"
          },
          "children": [
            {
              "definition": "tile/row",
              "attributes": {
                "gap": "md",
                "align": "center",
                "justify": "between"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center"
                  },
                  "children": [
                    {
                      "definition": "tile/icon",
                      "attributes": {
                        "name": "building",
                        "size": "sm",
                        "color": "muted",
                        "alt": "Storefront"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.name}",
                        "variant": "h2"
                      }
                    }
                  ]
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center"
                  },
                  "children": [
                    {
                      "definition": "tile/icon",
                      "attributes": {
                        "name": "activity",
                        "size": "sm",
                        "color": "muted",
                        "alt": "Status"
                      }
                    },
                    {
                      "definition": "tile/badge",
                      "attributes": {
                        "label": "{!$attrs.status}",
                        "variant": "{!$attrs.statusVariant}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}